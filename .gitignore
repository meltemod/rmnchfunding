# ---- R ------------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
.Renviron
.env

# ---- Build artefacts ----------------------------------------------------
# Everything here is regenerated by `R CMD build` / `R CMD check`.
*.tar.gz
*.Rcheck/
src/*.o
src/*.so
src/*.dll
inst/doc/

# ---- pkgdown ------------------------------------------------------------
# The site is built and deployed by CI to the gh-pages branch, so the local
# docs/ tree is a build artefact. If you deploy by committing docs/ instead,
# delete this line.
docs/

# ---- renv ---------------------------------------------------------------
# renv.lock IS committed when renv is in use; the library never is.
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# ---- OS / editor --------------------------------------------------------
.DS_Store
.vscode/

# ---- third-party reference workbooks -------------------------------------
# The full Muskoka2 workbook is 187 MB, over GitHub's 100 MB per-file limit,
# and is CC BY-NC 3.0 rather than this package's MIT. It is not redistributed.
# Download it when needed from the LSHTM Data Compass record cited in
# data-raw/reference/README.md; nothing in the build depends on it.
data-raw/reference/*.xlsb
